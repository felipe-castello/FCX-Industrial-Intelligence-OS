{
  "name": "fcx-industrial-backend",
  "version": "0.1.0",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "security:jwt": "node scripts/generate-jwt.js",
    "mqtt:simulator": "node scripts/mqtt-simulator.js",
    "test": "npm run test:regression",
    "test:regression": "node --test test/safe-multi-company.regression.test.js test/auth-rbac.regression.test.js",
    "test:e2e:production": "node --test test/multi-company.production.e2e.test.js",
    "test:e2e:homologation": "node --test test/auth-rbac.homologation.e2e.test.js",
    "phase4:simulate": "npm run build && node scripts/run-phase4-validation.js",
    "phase5:validate": "npm run build && node scripts/run-phase5-runtime-validation.js"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/schedule": "latest",
    "@prisma/client": "^6.19.3",
    "axios": "latest",
    "bcrypt": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "compression": "latest",
    "helmet": "latest",
    "ioredis": "latest",
    "modbus-serial": "latest",
    "mqtt": "latest",
    "prisma": "^6.19.3",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/compression": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
